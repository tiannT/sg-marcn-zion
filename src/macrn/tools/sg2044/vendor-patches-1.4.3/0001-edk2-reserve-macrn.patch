@@ -19,6 +19,7 @@
 //
 // The Library classes this module consumes
 //
+#include <Library/BaseLib.h>
 #include <Library/DebugLib.h>
 #include <Library/HobLib.h>
 #include <Library/IoLib.h>
@@ -255,6 +256,8 @@ InitializeRamRegions (
   UINT64                MemBaseAddress;
   UINT64                MemSizeEfuse;
   UINT64                ReservedMemSize;
+  UINT64                MacrnBase;
+  UINT64                MacrnSize;
 
   Status = GetMemSizeFromEfusePei (&MemSizeEfuse);
   if (EFI_ERROR (Status)) {
@@ -287,7 +290,27 @@ InitializeRamRegions (
   ShowMemValue("MemSizeTotal    ", MemSizeEfuse);
   ShowMemValue("MemSizeReserved ", ReservedMemSize);
 
-  AddMemoryRangeHob (MemBaseAddress, MemSize);
+  // Preserve this release's published upper address. Its existing call
+  // passes MemSize as a limit, rather than as a byte count.
+  MacrnBase = FixedPcdGet64 (PcdMacrnReservedBase);
+  MacrnSize = FixedPcdGet64 (PcdMacrnReservedSize);
+  if (MacrnSize == 0) {
+    AddMemoryRangeHob (MemBaseAddress, MemSize);
+    return;
+  }
+  if ((MacrnBase < MemBaseAddress) || (MacrnBase > MemSize) ||
+      (MacrnSize > MemSize - MacrnBase)) {
+    DEBUG ((DEBUG_ERROR, "Invalid m-ACRN reservation\n"));
+    ASSERT (FALSE);
+    CpuDeadLoop ();
+  }
+  if (MacrnBase > MemBaseAddress) {
+    AddMemoryRangeHob (MemBaseAddress, MacrnBase);
+  }
+  AddReservedMemoryBaseSizeHob (MacrnBase, MacrnSize);
+  if (MacrnBase + MacrnSize < MemSize) {
+    AddMemoryRangeHob (MacrnBase + MacrnSize, MemSize);
+  }
 }
 
 
